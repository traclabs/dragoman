{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "text",
      "text": "Removing old battery from rack with Dextre arm 1"
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IDLE"
        }
      ]
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/send_canned_pose",
      "extraOptions": [],
      "arguments": [
        {
          "name": "group_name",
          "value": "dextre_arm_1"
        },
        {
          "name": "group_canned_pose",
          "value": "go_to_rack_1"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IN_PROGRESS"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "DONE"
        }
      ]
    },
    {
      "type": "text",
      "text": "Dextre arm 1 approaching battery rack position 1"
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/send_canned_pose",
      "extraOptions": [],
      "arguments": [
        {
          "name": "group_name",
          "value": "dextre_arm_1"
        },
        {
          "name": "group_canned_pose",
          "value": "go_to_rack_2"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IN_PROGRESS"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "DONE"
        }
      ]
    },
    {
      "type": "text",
      "text": "Dextre arm 1 grasping battery"
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/GraspBattery",
      "extraOptions": [],
      "arguments": [
        {
          "name": "battery_name",
          "value": "s4_truss_23_battery_top_right"
        }
      ]
    },
    {
      "type": "sleep",
      "duration": 3000
    },
    {
      "type": "text",
      "text": "Battery attached"
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/send_canned_pose",
      "extraOptions": [],
      "arguments": [
        {
          "name": "group_name",
          "value": "dextre_arm_1"
        },
        {
          "name": "group_canned_pose",
          "value": "go_to_rack_1"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IN_PROGRESS"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "DONE"
        }
      ]
    },
    {
      "type": "text",
      "text": "Dextre arm 1 retracting with battery"
    }
  ],
  "advancement": {
    "acknowledgment": "Acknowledge_Queued",
    "wait": 0
  }
}
