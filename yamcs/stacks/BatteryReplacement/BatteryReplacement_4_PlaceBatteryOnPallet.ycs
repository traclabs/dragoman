{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "text",
      "text": "Placing old battery on pallet"
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IDLE"
        }
      ]
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/send_canned_pose",
      "extraOptions": [],
      "arguments": [
        {
          "name": "group_name",
          "value": "dextre_arm_1"
        },
        {
          "name": "group_canned_pose",
          "value": "place_on_pallet_1"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IN_PROGRESS"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "DONE"
        }
      ]
    },
    {
      "type": "text",
      "text": "Dextre arm 1 placing battery on pallet position 1"
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/send_canned_pose",
      "extraOptions": [],
      "arguments": [
        {
          "name": "group_name",
          "value": "dextre_arm_1"
        },
        {
          "name": "group_canned_pose",
          "value": "place_on_pallet_2"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IN_PROGRESS"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "DONE"
        }
      ]
    },
    {
      "type": "text",
      "text": "Releasing battery on pallet"
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/ReleaseBattery",
      "extraOptions": [],
      "arguments": [
        {
          "name": "battery_name",
          "value": "s4_truss_23_battery_top_right"
        }
      ]
    },
    {
      "type": "text",
      "text": "Battery detached"
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/send_canned_pose",
      "extraOptions": [],
      "arguments": [
        {
          "name": "group_name",
          "value": "dextre_arm_1"
        },
        {
          "name": "group_canned_pose",
          "value": "leave_on_pallet_1"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IN_PROGRESS"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "DONE"
        }
      ]
    },
    {
      "type": "text",
      "text": "Dextre arm 1 retracting from pallet"
    }
  ],
  "advancement": {
    "acknowledgment": "Acknowledge_Queued",
    "wait": 0
  }
}
