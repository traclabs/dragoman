{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IDLE"
        }
      ]
    },
    {
      "type": "text",
      "text": "Dextre arm 1 moving to rack position 1"
    },
    {
      "type": "command",
      "name": "/MobileServicingSystem/send_canned_pose",
      "extraOptions": [],
      "arguments": [
        {
          "name": "group_name",
          "value": "dextre_arm_1"
        },
        {
          "name": "group_canned_pose",
          "value": "go_to_rack_1"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "IN_PROGRESS"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
