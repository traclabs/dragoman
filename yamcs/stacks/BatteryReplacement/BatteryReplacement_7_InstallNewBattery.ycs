    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/MobileServicingSystem/motion_command_status.dextre_arm_1",
          "operator": "eq",
          "value": "DONE"
        }
      ]
    },
    {
      "type": "text",
      "text": "Releasing spare battery in rack"
    },
